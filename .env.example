# Копирай този файл на реалната машина като ".env" (без .example) и попълни
# истински стойности. .env е в .gitignore -- не се комитва, не се пуска в git.

# Генерирай с:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# На реален обект винаги False -- иначе грешка показва traceback с части от кода.
DEBUG=False

# Само тази машина -- касата се отваря през http://localhost:<порт>.
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=stora_db
DB_USER=stora_usr
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Отделна, само-за-четене роля за AI режима на справките (виж
# db_create_ai_readonly_role.sql) -- изпълни скрипта веднъж (като postgres
# супер-потребителя, същия който създаде DB_USER по-горе), после сложи
# истинската парола тук.
DB_READONLY_USER=stora_ai_readonly
DB_READONLY_PASSWORD=

# AI режим на справките (Reports app) -- ключ от https://console.anthropic.com
ANTHROPIC_API_KEY=
# По избор -- остави закоментирано за подразбиращия се модел (claude-sonnet-5).
# Ако решиш да я зададеш, задължително с реална стойност -- празно
# AI_REPORTS_MODEL= би презаписало подразбиращата се стойност с празен низ,
# не я оставя да проработи.
# AI_REPORTS_MODEL=
