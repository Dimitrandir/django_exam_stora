# Копирай този файл на реалната машина като ".env" (без .example) и попълни
# истински стойности. .env е в .gitignore -- не се комитва, не се пуска в git.

# Генерирай с:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# На реален обект винаги False -- иначе грешка показва traceback с части от кода.
DEBUG=False

# Само тази машина -- касата се отваря през http://localhost:<порт>.
ALLOWED_HOSTS=localhost,127.0.0.1

# Само за хостинг със стар PostgreSQL (под 14, напр. СуперХостинг -- 10.23),
# виж DEPLOYMENT_SUPERHOSTING.md. На обектите остави закоментирано.
# DB_ENGINE=STORA.db_backends.postgresql_legacy

DB_NAME=stora_db
DB_USER=stora_usr
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Отделна, само-за-четене роля за AI режима на справките (виж
# db_create_ai_readonly_role.sql) -- изпълни скрипта веднъж (като postgres
# супер-потребителя, същия който създаде DB_USER по-горе), после сложи
# истинската парола тук.
DB_READONLY_USER=stora_ai_readonly
DB_READONLY_PASSWORD=

# AI режим на справките (Reports app) -- ключ от https://console.anthropic.com
ANTHROPIC_API_KEY=
# По избор -- остави закоментирано за подразбиращия се модел (claude-sonnet-5).
# Ако решиш да я зададеш, задължително с реална стойност -- празно
# AI_REPORTS_MODEL= би презаписало подразбиращата се стойност с празен низ,
# не я оставя да проработи.
# AI_REPORTS_MODEL=

# Фискален принтер (Daisy Perfect S01, през ECRCommApp) -- виж
# STORA/sales/fiscal.py и kasov_aparat.md/kasov_aparat_ECRCommApp_Guide.pdf
# в корена на проекта. FISCAL_ENABLED=False (или изобщо липсващо) означава
# CASH продажбите просто не се опитват да фискализират -- безопасно за dev
# машина без реалния апарат. Постави True само на реалната Windows машина,
# след като всичко по-долу е попълнено с реални стойности.
FISCAL_ENABLED=False
# Пълен път до ecrcommapp_win_x64.exe на Windows машината, напр.
# C:\ECRCommApp\ecrcommapp_win_x64.exe
FISCAL_ECRCOMMAPP_PATH=
FISCAL_COM_PORT=COM4
FISCAL_API_URL=http://127.0.0.1:7000/Api
# Сериен номер на устройството (виж Daisy Manager -> Настройки -> "Номер на
# устройството"), напр. DY497635.
FISCAL_DEVICE_SERIAL=
# Номер на ФП (фискална памет) -- ДРУГО число от Daisy Manager -> Настройки
# ("Номер на ФП"), не серийния номер отгоре. Нужно само за сторно.
FISCAL_DEVICE_FM_NUMBER=
# Номер и парола на оператора, програмирани на самия апарат (виж менюто
# Програмиране -> Оператори на апарата) -- НЕ паролата за PC режим.
# ВАЖНО за сторно: всеки оператор има ОТДЕЛНИ права за сторно операции
# (Програмиране -> Оператори -> <номер> -> Сторно операции -- Рекламация/
# Оп.грешка/СТОРНО други), по подразбиране 0 (Забранен) за ВСЕКИ оператор,
# включително обикновените 1-18. Потвърдено на живо: Оператор 1 връщаше
# "fiscal device service error -- 7" (ЗАБР.ОПЕРАЦИЯ) на всяко FDStartFiscRcp
# със Refund="R", докато същите операции с Оператор 20 (администраторски,
# парола по подразбиране 9999) минаваха веднага. Ако продажбите работят, но
# сторно винаги гърми с грешка 7 -- първо провери тези права на апарата,
# преди да ровиш в JSON полетата.
FISCAL_OPERATOR_NUM=1
FISCAL_OPERATOR_PASSWORD=
# True -- всяка команда към ECRCommApp (и отговорът ѝ) се логва в конзолата/
# logs/stora.log, докато тестваш на живо срещу реалния апарат. Остави False
# за нормална работа (не спамва лога при всяка продажба).
FISCAL_DEBUG=False
# local (по подразбиране, магазините): STORA сама пуска ECRCommApp на същия
# компютър. bridge (само облачната инсталация): браузърът на касиера праща
# бона към fiscal_bridge/bridge.py на касовия компютър, на FISCAL_BRIDGE_URL.
# В bridge режим FISCAL_ECRCOMMAPP_PATH/FISCAL_COM_PORT/FISCAL_API_URL не се
# ползват тук -- те са в bridge.ini на касовия компютър.
FISCAL_MODE=local
FISCAL_BRIDGE_URL=http://127.0.0.1:7777
